# Copy to .env (gitignored) and fill in. Compose reads .env next to compose.yaml on its own and
# substitutes the ${...} references; compose.yaml fails fast on any that are empty or missing.
# Generate each password with: openssl rand -hex 24
# Hex, not base64: these passwords go into database URLs later, where base64's "/", "+" and "="
# would need URL-encoding.

# Superuser of the local postgres container. Only the init script and admin psql use it.
POSTGRES_PASSWORD=

# Per database: the owner role runs migrations and owns the tables, the app role reads and writes
# data only (postgres/initdb/01-databases.sh). The init script runs only on an empty volume, so after
# changing one of these, recreate it: docker compose down -v
AUTH_OWNER_PASSWORD=
AUTH_APP_PASSWORD=
MEMBERS_OWNER_PASSWORD=
MEMBERS_APP_PASSWORD=

# auth-server. A fresh secret, not your dev one: openssl rand -base64 32 (it never goes in a URL).
BETTER_AUTH_SECRET=
# Shared secret auth-server sends to membership-management's /internal/* (X-Internal-Token); both
# services read this one value. 32+ characters: openssl rand -hex 32
INTERNAL_API_TOKEN=
# Resend, so verification, reset and invite emails actually send. Your dev values work.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# membership-management: the Azure SQL DEV copy, never prod (its firewall must allow your public
# IP). The password is in the URL, so URL-encode special characters, and an "@" in the username
# (Azure's user@server form) as %40. Keep Encrypt=yes, e.g.
# mssql+pyodbc://<user>%40<server>:<password>@<server>.database.windows.net:1433/<db>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes
ASSIMILATION_DATABASE_URL=
